# MQTT
MQTT_DRY_RUN=true
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# Camera
CAMERA_INDEX=0
SHOW_WINDOW=true

# Fallback video when camera is unavailable
# Example: TEST_VIDEO=test_fall.mp4
TEST_VIDEO=

# FastAPI snapshot URL
# Laptop local test:
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Raspberry Pi E2E example:
# PUBLIC_BASE_URL=http://<PI_IP>:8000