        "func": "var lastAlertTime = global.get('fallLastAlertTime') || 0;\nvar now = Date.now();\n\n\n\nif (lastAlertTime === 0 || (now - lastAlertTime) > 5 * 60 * 1000) {\n\n    return null;\n}\n\nglobal.set('fallLastAlertTime', 0); // reset lại\n\n\nvar alarmMsg = { topic: \"home/esp32/alarm\", payload: \"ALARM_OFF\" };\nvar telegramMsg = {\n    payload: {\n        chatId: \"8823676499\",\n        type: \"message\",\n        content: \"✅ Đã xác nhận an toàn. Báo động té ngã tự hủy.\"\n    }\n};\nreturn [alarmMsg, telegramMsg];",
