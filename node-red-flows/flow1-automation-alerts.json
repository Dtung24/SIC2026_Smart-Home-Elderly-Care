        "func": "// ===== DEBOUNCE =====\nvar lastAlertTime = global.get('fallLastAlertTime') || 0;\nvar now = Date.now();\nvar COOLDOWN = 60 * 1000; // 60 giây\n\n\nif (lastAlertTime !== 0 && (now - lastAlertTime) < COOLDOWN) {\n    return null; // đang cooldown, chặn\n}\n\nglobal.set('fallLastAlertTime', now); // Cập nhật mốc thời gian mới\n\n// ===== PHÂN LOẠI + TIMESTAMP =====\nmsg.topic = \"fall\";\nmsg.eventTime = new Date().toISOString();\n\n\nif (msg.payload && msg.payload.image_path) {\n    msg.filename = msg.payload.image_path;\n} else {\n    msg.filename = \"/home/ngo-gia-bac/test_fall.jpg\";\n}\n\nmsg.payload = \"⚠️ CẢNH BÁO: Phát hiện người cao tuổi bị ngã\";\nreturn msg;",
