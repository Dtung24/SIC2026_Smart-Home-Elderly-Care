        "type": "function",
        "z": "23fca5e39a42fd2d",
        "name": "function 7",
        "func": "// Khởi tạo biến toàn cục lưu mốc thời gian lần chạy trước (nếu chưa có)\nif (typeof global.gasLastAlertTime === 'undefined') {\n    global.gasLastAlertTime = 0;\n}\n\nvar now = Date.now();\nvar COOLDOWN = 60 * 1000; // 60 giây\nvar diff = now - global.gasLastAlertTime;\n\nnode.warn(\"Gas Gate check - diff: \" + diff + \"ms (cooldown=\" + COOLDOWN + \"ms)\");\n\n// Nếu là lần đầu tiên hoặc đã qua thời gian cooldown\nif (global.gasLastAlertTime === 0 || diff >= COOLDOWN) {\n    global.gasLastAlertTime = now; // Cập nhật mốc thời gian mới\n    msg.topic = \"gas\";\n    msg.eventTime = new Date().toISOString();\n    return msg; // Cho phép đi qua\n} else {\n    return null; // Chặn lại vì đang trong thời gian cooldown\n}",
