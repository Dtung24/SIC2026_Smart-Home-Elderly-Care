    {
        "id": "c32d6d34023e1e8b",
        "type": "function",
        "z": "23fca5e39a42fd2d",
        "name": "function 5",
        "func": "// 1. Khởi tạo biến toàn cục chống spam cho luồng DHT22\nif (typeof global.dhtLastAlertTime === 'undefined') {\n    global.dhtLastAlertTime = 0;\n}\n\nvar now = Date.now();\nvar COOLDOWN = 60 * 1000; // 60 giây cooldown giữa các lần báo động DHT\nvar diff = now - global.dhtLastAlertTime;\n\n\n// 2. Kiểm tra điều kiện ngưỡng cảm biến như cũ\nconst data = msg.payload;\nconst temp = data.temp;\nconst humidity = data.humidity;\n\nconst TEMP_HIGH = 35;\nconst TEMP_LOW = 16;\nconst HUMID_HIGH = 85;\n\nlet alert = null;\n\nif (temp >= TEMP_HIGH) {\n    alert = `⚠️ Nhiệt độ quá cao: ${temp}°C. Kiểm tra điều hòa/quạt cho người già.`;\n} else if (temp <= TEMP_LOW) {\n    alert = `⚠️ Nhiệt độ quá thấp: ${temp}°C. Cần giữ ấm cho người già.`;\n} else if (humidity >= HUMID_HIGH) {\n    alert = `⚠️ Độ ẩm cao bất thường: ${humidity}%.`;\n}\n\n// 3. Nếu có cảnh báo VÀ đã qua thời gian cooldown thì mới cho đi\nif (alert) {\n    if (global.dhtLastAlertTime === 0 || diff >= COOLDOWN) {\n        global.dhtLastAlertTime = now; // Cập nhật mốc thời gian mới\n        \n        msg.topic = \"dht22\";\n        msg.eventTime = new Date().toISOString();\n        msg.payload = {\n            chatId: \"8823676499\",\n            type: \"message\",\n            content: alert\n        };\n        return msg;\n    } else {\n        // Đang trong thời gian cooldown -> Chặn lại không gửi Telegram dồn dập\n        return null;\n    }\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
